// -------------------------------------------------------------
// StickTheBizz — Decoupled PostgreSQL Database Schema (Prisma)
// Connects directly to Supabase PostgreSQL without Supabase Auth SDKs
// -------------------------------------------------------------

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  MERCHANT
  CUSTOMER
  ADMIN
}

enum VisitStatus {
  PENDING
  APPROVED
  REJECTED
  REDEEMED
}

enum SubscriptionStatus {
  ACTIVE
  GRACE_PERIOD
  INACTIVE
  EXPIRED
}

enum SubscriptionPlanId {
  MONTHLY
  YEARLY
}

enum PromoDiscountType {
  PERCENT
  FLAT
  FIXED_FINAL
}

// -------------------------------------------------------------
// 1. CUSTOM AUTH & SESSION MODELS (Self-Hosted Auth)
// -------------------------------------------------------------

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  phone        String?   @unique @db.VarChar(20)
  fullName     String?   @map("full_name") @db.VarChar(120)
  role         UserRole  @default(CUSTOMER)
  passwordHash String?   @map("password_hash") @db.VarChar(255) // For shop owners
  isVerified   Boolean   @default(false) @map("is_verified")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sessions  Session[]
  merchants Merchant[]
  customer  Customer?

  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  refreshToken String   @unique @map("refresh_token") @db.VarChar(512)
  userAgent    String?  @map("user_agent") @db.VarChar(255)
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model OtpCode {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @db.VarChar(255)
  codeHash  String   @map("code_hash") @db.VarChar(255) // HMAC-SHA256 hash of 6-digit OTP
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  expiresAt DateTime @map("expires_at") @db.Timestamptz // 5 minutes TTL
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email, consumed, expiresAt])
  @@map("otp_codes")
}

// -------------------------------------------------------------
// 2. CORE RETAIL LOYALTY DOMAIN MODELS
// -------------------------------------------------------------

model Merchant {
  id                    String             @id @default(uuid()) @db.Uuid
  ownerId               String             @map("owner_id") @db.Uuid
  slug                  String             @unique @db.VarChar(100)
  name                  String             @db.VarChar(150)
  category              String             @default("Cafe / Chai") @db.VarChar(80)
  minSpend              Decimal            @default(100) @map("min_spend") @db.Decimal(10, 2)
  visitsRequired        Int                @default(10) @map("visits_required")
  rewardName            String             @default("1 Free Special Item") @map("reward_name") @db.VarChar(150)
  validityDays          Int                @default(30) @map("validity_days")
  redemptionPin         String             @default("2468") @map("redemption_pin") @db.VarChar(10)
  qrToken               String?            @map("qr_token") @db.VarChar(100)
  subscriptionStatus    SubscriptionStatus @default(ACTIVE) @map("subscription_status")
  subscriptionPlan      SubscriptionPlanId @default(MONTHLY) @map("subscription_plan")
  subscriptionStartedAt DateTime?          @map("subscription_started_at") @db.Timestamptz
  subscriptionExpiresAt DateTime?          @map("subscription_expires_at") @db.Timestamptz
  gracePeriodEndsAt     DateTime?          @map("grace_period_ends_at") @db.Timestamptz
  razorpayPaymentId     String?            @map("razorpay_payment_id") @db.VarChar(100)
  razorpayOrderId       String?            @map("razorpay_order_id") @db.VarChar(100)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  visits      Visit[]
  redemptions Redemption[]

  @@map("merchants")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @unique @map("user_id") @db.Uuid
  phone     String?  @unique @db.VarChar(20) // Nullable for instant Email OTP signup before linking phone
  email     String?  @unique @db.VarChar(255) // Unique index for fast 1-to-1 lookups
  fullName  String?  @map("full_name") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  visits      Visit[]
  redemptions Redemption[]

  @@index([phone])
  @@index([email])
  @@map("customers")
}

model Visit {
  id           String      @id @default(uuid()) @db.Uuid
  merchantId   String      @map("merchant_id") @db.Uuid
  customerId   String      @map("customer_id") @db.Uuid
  billAmount   Decimal     @default(100) @map("bill_amount") @db.Decimal(10, 2)
  status       VisitStatus @default(PENDING)
  visitDateIst String      @map("visit_date_ist") @db.VarChar(10) // "YYYY-MM-DD" in Asia/Kolkata
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Enforces strictly 1 scan per calendar day in IST
  @@unique([merchantId, customerId, visitDateIst], name: "unique_daily_scan")
  @@index([merchantId, status])
  @@index([customerId])
  @@map("visits")
}

model Redemption {
  id           String   @id @default(uuid()) @db.Uuid
  merchantId   String   @map("merchant_id") @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  rewardName   String   @map("reward_name") @db.VarChar(150)
  stampsBurned Int      @map("stamps_burned")
  redeemedAt   DateTime @default(now()) @map("redeemed_at") @db.Timestamptz

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([customerId])
  @@map("redemptions")
}

model PromoCode {
  id             String            @id @default(uuid()) @db.Uuid
  code           String            @unique @db.VarChar(50)
  discountType   PromoDiscountType @map("discount_type")
  discountValue  Decimal           @map("discount_value") @db.Decimal(10, 2)
  applicablePlan String            @default("ALL") @map("applicable_plan") @db.VarChar(50)
  maxUses        Int               @default(1000) @map("max_uses")
  timesUsed      Int               @default(0) @map("times_used")
  isActive       Boolean           @default(true) @map("is_active")
  expiresAt      DateTime?         @map("expires_at") @db.Timestamptz
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@map("promo_codes")
}

model IdempotencyKey {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(128)
  action    String   @db.VarChar(100)
  response  Json
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("idempotency_keys")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorType  String   @map("actor_type") @db.VarChar(50)
  actorId    String?  @map("actor_id") @db.VarChar(100)
  action     String   @db.VarChar(100)
  resourceId String?  @map("resource_id") @db.VarChar(100)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("audit_logs")
}

