# -------------------------------------------------------------
# StickTheBizz Backend Service Environment Configuration
# -------------------------------------------------------------

# Server Configuration
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000,https://stickthebizz.in

# Supabase PostgreSQL Connection Pooler (Port 6543 with ?pgbouncer=true for transactions)
DATABASE_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct PostgreSQL Connection (Port 5432 for Prisma migrations)
DIRECT_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Authentication & Cryptographic Secrets
JWT_ACCESS_SECRET="stb-jwt-access-secret-minimum-32-characters-long"
JWT_REFRESH_SECRET="stb-jwt-refresh-secret-minimum-32-characters-long"
OTP_SECRET="stb-hmac-sha256-otp-hash-secret-minimum-32-characters-long"

# Resend Email Delivery for Customer OTPs
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwx"
EMAIL_FROM="StickTheBizz Loyalty <noreply@stickthebizz.in>"

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID="rzp_live_TwB6i8HNWltApy"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Internal Cron Security Secret (for 12:00 AM IST daily reset trigger)
CRON_SECRET="stb-internal-cron-trigger-secret-key"

