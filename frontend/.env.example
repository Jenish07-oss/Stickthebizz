# Deployment Environment Identity: development | staging | preview | production
NEXT_PUBLIC_APP_ENV=development

# Fastify Backend API URL (Default: http://localhost:8000 in dev; HTTPS required in staging/preview/prod)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Fastify WebSocket URL (Optional: auto-derived from API URL as ws:// or wss://.../ws if omitted)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Razorpay Key ID (Public Client Key - use test credentials in non-production)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholderKey

